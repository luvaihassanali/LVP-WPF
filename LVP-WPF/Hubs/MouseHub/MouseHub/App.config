<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="SerialPort" value="6"/>
		<add key="Esp8266Ip" value="192.168.0.138"/>
		<add key="Esp8266Port" value="3000"/>
		<add key="LVP-WPF-Path" value="%USERPROFILE%\Documents\apps\LVP-WPF\"/>
		<add key="Opacity" value="225"/>

		<!-- Console window size / screen position. Defaults match the
		     properties saved on the MouseHub.lnk shortcut so the window
		     looks identical whether launched from the shortcut OR
		     restarted by LVP-WPF. Without these, the previous hardcoded
		     Program.Main values (112 x 27 at -8,-8) wiped out the
		     shortcut's layout on every LVP restart cycle.
		     ConsoleWindowWidth  = char cells across (Window Size > Width)
		     ConsoleWindowHeight = char cells down   (Window Size > Height)
		     ConsoleBufferHeight = scrollback rows   (Screen Buffer Size > Height)
		     ConsoleWindowLeft   = screen pixels X   (Window Position > Left)
		     ConsoleWindowTop    = screen pixels Y   (Window Position > Top)

		     ConsoleBufferHeight defaults to ConsoleWindowHeight (no scrollback)
		     so conhost has no reason to draw a vertical scrollbar - the
		     buffer == window so there's nothing to scroll. Raise this back
		     to a larger value (e.g. 9001) if you want scrollback history;
		     the cost is the scrollbar reappearing on the right edge. -->
		<add key="ConsoleWindowWidth"  value="69"/>
		<add key="ConsoleWindowHeight" value="31"/>
		<add key="ConsoleBufferHeight" value="31"/>
		<add key="ConsoleWindowLeft"   value="1288"/>
		<add key="ConsoleWindowTop"    value="568"/>
		<!-- Font height in pixels - dominant control over the on-screen
		     window size. Total window ~= (cols * fontSize/2) wide x
		     (rows * fontSize) tall. Examples at 69x31 cells:
		       18 -> ~621 x 558 px  (compact)
		       20 -> ~690 x 620 px  (default)
		       28 -> ~966 x 868 px  (medium)
		       38 -> ~1311 x 1178 px (the original hardcoded value -
		             takes ~2/3 of a typical screen) -->
		<add key="ConsoleFontSize"     value="20"/>
	</appSettings>
</configuration>
